{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@portfolio/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@portfolio/shared-ui/styles": ["./libs/shared/ui/src/styles/globals.css"],

      "@portfolio/shared-hooks": ["./libs/shared/hooks/src/index.ts"],

      "@portfolio/shared-types": ["./libs/shared/types/src/index.ts"],

      "@portfolio/shared-database": ["./libs/shared/database/src/index.ts"],

      "@portfolio/shared-utils": ["./libs/shared/utils/src/index.ts"],
      
      "@/components/*": ["./libs/shared/ui/src/components/*"],
      "@portfolio/shared-ui/*": ["./libs/shared/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
