{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@portfolio/shared-ui": ["./libs/shared/ui/src/index.ts"],
      "@portfolio/shared-ui/*": ["./libs/shared/ui/src/*"],
      "@portfolio/shared-ui/styles": ["./libs/shared/ui/src/styles/globals.css"],
      "@portfolio/shared-hooks": ["./libs/shared/hooks/src/index.ts"],
      "@portfolio/shared-types": ["./libs/shared/types/src/index.ts"],
      "@portfolio/shared-database": ["./libs/shared/database/src/index.ts"],
      "@portfolio/shared-utils": ["./libs/shared/utils/src/index.ts"],
      
      "@/components/*": ["./libs/shared/ui/src/components/*"],

      "@portfolio/aperture": ["./libs/aperture/src/index.ts"],
      "@portfolio/aperture-hooks": ["./libs/aperture/src/hooks/index.ts"],
      "@portfolio/aperture-shared": ["./libs/aperture/src/shared/index.ts"],
      "@portfolio/aperture-utils": ["./libs/aperture/src/utils/index.ts"],
      "@portfolio/aperture-types": ["./libs/aperture/src/types/index.ts"],

      "@portfolio/nft-marketplace": ["./libs/nft-marketplace/src/index.ts"],
      "@portfolio/nft-marketplace-hooks": ["./libs/nft-marketplace/src/hooks/index.ts"],
      "@portfolio/nft-marketplace-shared": ["./libs/nft-marketplace/src/shared/index.ts"],
      "@portfolio/nft-marketplace-utils": ["./libs/nft-marketplace/src/utils/index.ts"],
      "@portfolio/nft-marketplace-types": ["./libs/nft-marketplace/src/types/index.ts"],
      "@portfolio/nft-marketplace-database": ["./libs/nft-marketplace/src/database/src/db.ts"],

      "@portfolio/rhine-media": ["./libs/rhine-media/src/index.ts"],
      "@portfolio/rhine-media-hooks": ["./libs/rhine-media/src/hooks/index.ts"],
      "@portfolio/rhine-media-shared": ["./libs/rhine-media/src/shared/index.ts"],
      "@portfolio/rhine-media-utils": ["./libs/rhine-media/src/utils/index.ts"],
      "@portfolio/rhine-media-types": ["./libs/rhine-media/src/types/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
