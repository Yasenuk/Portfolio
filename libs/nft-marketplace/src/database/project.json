{
  "name": "nft-marketplace-database",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/nft-marketplace/database/src",
  "projectType": "library",
  "tags": ["scope:nft-marketplace", "type:server-only"],
  "targets": {
    "prisma-generate": {
      "command": "prisma generate --config libs/nft-marketplace/src/database/prisma.config.ts"
    },
    "prisma-migrate": {
      "command": "prisma migrate dev --config libs/nft-marketplace/src/database/prisma.config.ts"
    },
    "prisma-studio": {
      "command": "prisma studio --config libs/nft-marketplace/src/database/prisma.config.ts"
    },
    "prisma-db-push": {
      "command": "prisma db push --config libs/nft-marketplace/src/database/prisma.config.ts"
    }
  }
}
